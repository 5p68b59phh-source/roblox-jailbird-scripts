local CoreGui = game:GetService("CoreGui")
local Player = game:GetService("Players").LocalPlayer
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Find Jailbird lobby GUI
local function findJailbirdGUI()
    for _, gui in pairs(CoreGui:GetDescendants()) do
        if gui:IsA("ScreenGui") and (gui.Name:find("Jailbird") or gui.Name:find("Lobby") or gui.Name:find("Menu")) then
            return gui
        end
    end
    if Player:FindFirstChild("PlayerGui") then
        for _, gui in pairs(Player.PlayerGui:GetDescendants()) do
            if gui:IsA("ScreenGui") and (gui.Name:find("Jailbird") or gui.Name:find("Lobby") or gui.Name:find("Menu")) then
                return gui
            end
        end
    end
    return nil
end

local jailbirdGUI = findJailbirdGUI()
if not jailbirdGUI then
    jailbirdGUI = Instance.new("ScreenGui")
    jailbirdGUI.Name = "JailbirdLobbyUI"
    jailbirdGUI.Parent = CoreGui
    jailbirdGUI.ResetOnSpawn = false
end

-- Create toggle button
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "HBV_ToggleButton"
ToggleButton.Size = UDim2.new(0, Jr., 0, 40)
ToggleButton.Position = UDim2.new(1, -130, 0, 20)
ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
ToggleButton.BorderSizePixel = 2
ToggleButton.BorderColor3 = Color3.fromRGB(100, 0, 200)
ToggleButton.Text = "HBV_hub Menu"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.Font = Enum.Font.SourceSansBold
