-- Tab buttons
local Tabs = {"Main", "Player", "Visuals", "Misc"}
local TabButtons = {}
local TabFrames = {}
local currentTab = "Main"

local function createTab(name, yPos)
    local tabButton = Instance.new("TextButton")
    tabButton.Name = name .. "Tab"
    tabButton.Size = UDim2.new(0, 80, 0, 35)
    tabButton.Position = UDim2.new(0, 10 + (90 * (yPos-1)), 0, 100)
    tabButton.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
    tabButton.BorderSizePixel = 0
    tabButton.Text = name
    tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabButton.Font = Enum.Font.SourceSansBold
    tabButton.TextSize = 14
    tabButton.ZIndex = 22
    tabButton.Parent = ContentFrame
    
    local tabFrame = Instance.new("Frame")
    tabFrame.Name = name .. "Content"
    tabFrame.Size = UDim2.new(1, -20, 0, 350)
    tabFrame.Position = UDim2.new(0, 10, 0, 150)
    tabFrame.BackgroundTransparency = 1
    tabFrame.Visible = (name == "Main")
    tabFrame.ZIndex = 21
    tabFrame.Parent = ContentFrame
    
    TabButtons[name] = tabButton
    TabFrames[name] = tabFrame
    
    tabButton.MouseButton1Click:Connect(function()
        currentTab = name
        for tabName, frame in pairs(TabFrames) do
            frame.Visible = (tabName == name)
        end
        for tabName, button in pairs(TabButtons) do
            if tabName == name then
                button.BackgroundColor3 = Color3.fromRGB(100, 0, 200)
            else
                button.BackgroundColor3 = Color3.fromRGB(60, 60, 90)
            end
        end
    end)
end

for i, tabName in ipairs(Tabs) do
    createTab(tabName, i)
end

-- Main tab features
local MainFrame = TabFrames["Main"]

-- NoClip
local NoClipToggle = Instance.new("TextButton")
NoClipToggle.Name = "NoClipToggle"
NoClipToggle.Size = UDim2.new(0, 180, 0, 45)
NoClipToggle.Position = UDim2.new(0, 20, 0, 20)
NoClipToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
NoClipToggle.BorderSizePixel = 0
NoClipToggle.Text = "NoClip: OFF"
NoClipToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
NoClipToggle.Font = Enum.Font.SourceSansBold
NoClipToggle.TextSize = 16
NoClipToggle.ZIndex = 22
NoClipToggle.Parent = MainFrame

local Noclipping = false
local NoclipLoop

local function Noclip()
    if Noclipping then return end
    Noclipping = true
    NoclipLoop = game:GetService("RunService").Stepped:Connect(function()
        if Player.Character then
            for _, part in pairs(Player.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function Clip()
    if not Noclipping then return end
    Noclipping = false
    if NoclipLoop then NoclipLoop:Disconnect() end
    if Player.Character then
        for _, part in pairs(Player.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

NoClipToggle.MouseButton1Click:Connect(function()
    if Noclipping then
        Clip()
        NoClipToggle.Text = "NoClip: OFF"
        NoClipToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
    else
        Noclip()
        NoClipToggle.Text = "NoClip: ON"
        NoClipToggle.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    end
end)

-- Fly
local FlyToggle = Instance.new("TextButton")
FlyToggle.Name = "FlyToggle"
FlyToggle.Size = UDim2.new(0, 180, 0, 45)
FlyToggle.Position = UDim2.new(0, 220, 0, 20)
FlyToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
FlyToggle.BorderSizePixel = 0
FlyToggle.Text = "Fly: OFF"
FlyToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
FlyToggle.Font = Enum.Font.SourceSansBold
FlyToggle.TextSize = 16
FlyToggle.ZIndex = 22
FlyToggle.Parent = MainFrame

local Flying = false
local FlySpeed = 50
FlyToggle.MouseButton1Click:Connect(function()
    Flying = not Flying
    if Flying then
        FlyToggle.Text = "Fly: ON"
        FlyToggle.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        -- Add fly script here
    else
        FlyToggle.Text = "Fly: OFF"
        FlyToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
        -- Remove fly script here
    end
end)

-- Toggle button functionality
local menuVisible = false
ToggleButton.MouseButton1Click:Connect(function()
    menuVisible = not menuVisible
    ModFrame.Visible = menuVisible
    if menuVisible then
        ToggleButton.Text = "Hide Menu"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(70, 20, 100)
    else
        ToggleButton.Text = "Show Menu"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
    end
end)

-- Minimize functionality
local minimized = false
local originalSize = ModFrame.Size
MinimizeButton.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        local tween = TweenService:Create(ModFrame, tweenInfo, {Size = UDim2.new(0, 450, 0, 45)})
        tween:Play()
        ContentFrame.Visible = false
        MinimizeButton.Text = "□"
    else
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        local tween = TweenService:Create(ModFrame, tweenInfo, {Size = originalSize})
        tween:Play()
        ContentFrame.Visible = true
        MinimizeButton.Text = "_"
    end
end)

-- Close button
CloseButton.MouseButton1Click:Connect(function()
    ModFrame.Visible = false
    menuVisible = false
    ToggleButton.Text = "Show Menu"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
    if Noclipping then
        Clip()
        NoClipToggle.Text = "NoClip: OFF"
        NoClipToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
    end
end)

-- Cleanup
Player.CharacterAdded:Connect(function()
    if Noclipping then
        Clip()
        NoClipToggle.Text = "NoClip: OFF"
        NoClipToggle.BackgroundColor3 = Color3.fromRGB(70, 70, 120)
    end
end)
